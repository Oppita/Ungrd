  "amazonas": [-71.5, -1.5],
  "antioquia": [-75.5, 7.0],
  "arauca": [-71.0, 7.0],
  "atlantico": [-74.9, 10.7],
  "bolivar": [-74.5, 9.0],
  "boyaca": [-73.0, 5.5],
  "caldas": [-75.4, 5.3],
  "caqueta": [-73.5, 1.0],
  "casanare": [-71.5, 5.5],
  "cauca": [-76.8, 2.5],
  "cesar": [-73.5, 9.5],
  "choco": [-76.8, 5.5],
  "cordoba": [-75.8, 8.5],
  "cundinamarca": [-74.0, 5.0],
  "guainia": [-69.0, 2.5],
  "guaviare": [-72.0, 2.0],
  "huila": [-75.5, 2.5],
  "la guajira": [-72.5, 11.5],
  "magdalena": [-74.0, 10.0],
  "meta": [-73.0, 3.5],
  "narino": [-78.0, 1.5],
  "norte de santander": [-73.0, 8.0],
  "putumayo": [-76.0, 0.5],
  "quindio": [-75.7, 4.5],
  "risaralda": [-76.0, 5.0],
  "san andres": [-81.7, 12.5],
  "santander": [-73.5, 6.5],
  "sucre": [-75.0, 9.0],
  "tolima": [-75.2, 4.0],
  "valle": [-76.5, 3.5],
