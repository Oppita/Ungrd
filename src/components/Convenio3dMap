import { Canvas, useFrame } from '@react-three/fiber';
import { OrbitControls, Html, Sphere, Stars, useGLTF, Line, Base, Geometry } from '@react-three/drei';
import * as THREE from 'three';
import { Project, Contract } from '../types';
import { Activity, MapPin } from 'lucide-react';

interface Convenio3DMapProps {
  projects: Project[];
  contracts: Contract[];
}

// Normalized dept coordinates (Longitude, Latitude) mapped to pseudo-3D
